# ForgeTeam AI - Environment Configuration
# Copy this file to .env and customize as needed

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=4096

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./forgeteam.db

# Demo Mode (set to true to use mock AI responses)
DEMO_MODE=false

# Generated Projects Directory
GENERATED_PROJECTS_DIR=../generated_projects

# Security
MAX_REVISION_ATTEMPTS=2
MAX_FILE_SIZE_BYTES=1048576
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker (optional - for sandboxed test execution)
DOCKER_ENABLED=false
DOCKER_TIMEOUT=60
